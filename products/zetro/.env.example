# Copy values into the ignored products/zetro/.env file.
# Keys are optional. Fill only providers you choose to use.
# Provider integration is in progress. These policy controls require the new loader.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
GEMINI_API_KEY=
# Trial-only candidate. Not an always-free service.
CEREBRAS_API_KEY=
# Optional research candidates. Not required for the first integration.
MISTRAL_API_KEY=
HF_TOKEN=

# Offline defaults. Key presence alone must never start inference.
ZETRO_PROVIDER=fake
ZETRO_MODEL=
ZETRO_LIVE_INFERENCE_ENABLED=false
ZETRO_ALLOW_REMOTE_SOURCE=false
ZETRO_FREE_ONLY=true
ZETRO_MAX_COST_USD=0
ZETRO_MAX_CONCURRENT_WORKERS=1
# Operator-approved provider destinations. Blank means none.
ZETRO_APPROVED_PROVIDERS=

# Model selections remain blank until discovery and benchmark verification.
GROQ_MODEL=
OPENROUTER_MODEL=
OPENCODE_MODEL=
GEMINI_MODEL=
CEREBRAS_MODEL=

# Optional local inference. No cloud API key is needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
